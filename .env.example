# TinyFish API credentials (required for live autonomous web lookups)
# Obtain your key from https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Publicly reachable application URL for remote browser access to warehouse portal
# For local development, set to a public tunnel URL (e.g. ngrok / cloudflared)
APP_BASE_URL=https://your-project.vercel.app

# Optional persistent database file path
DATABASE_PATH=.data/freightcommand.db

# MAP CONFIGURATION:
# NO MANDATORY MAP API CREDENTIALS.
# Leaflet + OpenStreetMap tiles operate out of the box with zero external API keys.
